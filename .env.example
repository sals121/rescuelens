# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
# Claude model used for verification and the rescue report.
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional
# RESCUELENS_MAX_COST_USD=10        # hard stop for LLM spend per run (USD)
# RESCUELENS_LLM_CONCURRENCY=4      # parallel Claude requests
# RESCUELENS_LOG_JSON=0             # 1 = JSON logs
# RESCUELENS_LOG_LEVEL=INFO
