# Copy to .env only if you want to change defaults. Never commit .env.
#
# How RescueLens reaches Claude (RESCUELENS_LLM_BACKEND):
#   auto         (default) API if ANTHROPIC_API_KEY is set, otherwise the local Claude Code CLI
#   claude-code  headless `claude -p` using your Claude subscription - no API key needed
#   api          Anthropic API via the official SDK - needs ANTHROPIC_API_KEY
# RESCUELENS_LLM_BACKEND=auto
# ANTHROPIC_API_KEY=sk-ant-...

# Claude model used for verification and the rescue report.
ANTHROPIC_MODEL=claude-opus-5-5

# Optional
# RESCUELENS_MAX_COST_USD=10        # hard stop on (API-equivalent) LLM spend per run
# RESCUELENS_LLM_CONCURRENCY=4      # parallel Claude requests
# RESCUELENS_LOG_JSON=0             # 1 = JSON logs
# RESCUELENS_LOG_LEVEL=INFO
